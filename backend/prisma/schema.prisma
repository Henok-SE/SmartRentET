// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  LANDLORD
  TENANT
  OFFICER
  ADMIN
}

enum AgreementStatus {
  DRAFT
  PENDING_REVIEW
  PARTIES_VERIFIED
  SERVICE_FEE_PENDING
  APPROVED
  ACTIVE
  ENDED
  TERMINATED
  REJECTED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum ApprovalType {
  REVIEW
  FINAL_APPROVAL
}

model User {
  userId       Int      @id @default(autoincrement())
  firstName    String
  middleName   String?
  lastName     String
  phone        String
  nationalId   String   @unique
  finNumber    String?
  username     String?  @unique
  passwordHash String?
  role         UserRole
  mfaEnabled   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  landlord            Landlord?
  tenant              Tenant?
  systemAdministrator SystemAdministrator?
  officer             Officer?
  auditLogs           AuditLog[]
}

model Landlord {
  landlordId        Int      @id @default(autoincrement())
  userId            Int      @unique
  address           String
  subCity           String?
  houseNumber       String
  businessLicense   String?
  bankAccountNumber String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user       User              @relation(fields: [userId], references: [userId])
  properties Property[]
  agreements RentalAgreement[]
}

model Tenant {
  tenantId              Int      @id @default(autoincrement())
  userId                Int      @unique
  emergencyContactName  String?
  emergencyContactPhone String?
  employer              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user       User              @relation(fields: [userId], references: [userId])
  agreements RentalAgreement[]
}

model SystemAdministrator {
  adminId   Int      @id @default(autoincrement())
  userId    Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userId])
}

model Property {
  propertyId    Int      @id @default(autoincrement())
  landlordId    Int
  location      String
  subCity       String
  woreda        String
  houseNumber   String
  propertyType  String
  numberOfUnits Int
  status        String
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  landlord Landlord @relation(fields: [landlordId], references: [landlordId])
  units    Unit[]

  @@index([landlordId])
}

model Unit {
  unitId          Int      @id @default(autoincrement())
  propertyId      Int
  unitNumber      String
  floor           Int
  sizeSqMeters    Decimal
  bedrooms        Int
  bathrooms       Int
  status          String
  rentAmountFloor Decimal
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  property   Property          @relation(fields: [propertyId], references: [propertyId])
  agreements RentalAgreement[]

  @@unique([propertyId, unitNumber])
  @@index([propertyId])
}

model RentalAgreement {
  agreementId         Int             @id @default(autoincrement())
  referenceNumber     String?         @unique
  unitId              Int
  landlordId          Int
  tenantId            Int
  paymentFrequencyId  Int
  monthlyRent         Decimal
  securityDeposit     Decimal?
  status              AgreementStatus @default(DRAFT)
  effectiveDate       DateTime
  terminationDate     DateTime?
  renewalDate         DateTime?
  previousAgreementId Int?
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  unit             Unit             @relation(fields: [unitId], references: [unitId])
  landlord         Landlord         @relation(fields: [landlordId], references: [landlordId])
  tenant           Tenant           @relation(fields: [tenantId], references: [tenantId])
  paymentFrequency PaymentFrequency @relation(fields: [paymentFrequencyId], references: [frequencyId])

  previousAgreement RentalAgreement? @relation("AgreementRenewal", fields: [previousAgreementId], references: [agreementId])

  renewedAgreements RentalAgreement[] @relation("AgreementRenewal")

  agreementApprovals AgreementApproval[]
  ussdConsent        USSDConsent?
  feePayment         GovernmentFeePayment?

  @@index([unitId])
  @@index([landlordId])
  @@index([tenantId])
  @@index([paymentFrequencyId])
}
model USSDConsent {
  consentId          Int      @id @default(autoincrement())
  agreementId        Int      @unique
  tenantPhone        String
  landlordPhone      String
  tenantConsent      Boolean  @default(false)
  landlordConsent    Boolean  @default(false)
  tenantConsentDate  DateTime?
  landlordConsentDate DateTime?
  tenantVerificationCode String?
  landlordVerificationCode String?
  tenantCodeExpiresAt  DateTime?
  landlordCodeExpiresAt DateTime?
  consentType        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  agreement RentalAgreement @relation(fields: [agreementId], references: [agreementId])
}

model GovernmentFeePayment {
  paymentId     Int       @id @default(autoincrement())
  agreementId   Int       @unique
  landlordId    Int
  tenantId      Int?
  amount        Decimal   @default(50)
  currency      String    @default("ETB")
  status        String    @default("PENDING")
  transactionId String?
  paymentDate   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  agreement RentalAgreement @relation(fields: [agreementId], references: [agreementId])
}

model OTP {
  otpId     Int      @id @default(autoincrement())
  userId    Int
  code      String
  type      String   @default("LOGIN")
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PaymentFrequency {
  frequencyId     Int      @id @default(autoincrement())
  name            String   @unique
  minimumInterval Int
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agreements RentalAgreement[]
}

model Officer {
  officerId  Int      @id @default(autoincrement())
  userId     Int      @unique
  employeeId String   @unique
  subCity    String
  assignedTo String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [userId])
  agreementApprovals AgreementApproval[]
}

model AgreementApproval {
  approvalId   Int              @id @default(autoincrement())
  agreementId  Int
  officerId    Int
  approvalType ApprovalType
  decision     ApprovalDecision
  comments     String?
  approvalDate DateTime         @default(now())

  agreement RentalAgreement @relation(fields: [agreementId], references: [agreementId])
  officer   Officer         @relation(fields: [officerId], references: [officerId])

  @@index([agreementId])
  @@index([officerId])
}

model AuditLog {
  logId      Int      @id @default(autoincrement())
  userId     Int
  actionType String
  entityType String
  entityId   Int?
  newValues  Json?
  oldValues  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [userId])
}

